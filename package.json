{
  "name": "MobileAnimation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "react-native start",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "lint": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "test": "jest",
    "prepare": "husky install",
    "android": "ENVFILE=.env.loc react-native run-android",
    "android:dev": "ENVFILE=.env.dev react-native run-android",
    "android:iqa": "ENVFILE=.env.iqa react-native run-android",
    "android:qa": "ENVFILE=.env.qa react-native run-android",
    "android:preprod": "ENVFILE=.env.preprod react-native run-android",
    "android:prod": "ENVFILE=.env.prod react-native run-android",
    "android:build": "npm run android:clean && cd android && ENVFILE=.env.loc ./gradlew assembleRelease",
    "android:build:dev": "npm run android:clean && cd android && ENVFILE=.env.dev ./gradlew assembleRelease",
    "android:build:iqa": "npm run android:clean && cd android && ENVFILE=.env.iqa ./gradlew assembleRelease",
    "android:build:qa": "npm run android:clean && cd android && ENVFILE=.env.qa ./gradlew assembleRelease",
    "android:build:preprod": "npm run android:clean && cd android && ENVFILE=.env.preprod ./gradlew assembleRelease",
    "android:build:prod": "npm run android:clean && cd android && ENVFILE=.env.prod ./gradlew assembleRelease",
    "android:clean": "rm -rf ./android/app/build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "7.10.2",
    "lottie-react-native": "^6.7.2",
    "lucide-react-native": "^1.33.0",
    "react": "18.2.0",
    "react-native": "0.72.4",
    "react-native-reanimated": "3.15.5",
    "react-native-sensors": "7.3.6",
    "react-native-svg": "15.7.1",
    "react-native-vision-camera": "3.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/node": "^18.11.9",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "patch-package": "^8.0.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "npm@11.12.1"
}
