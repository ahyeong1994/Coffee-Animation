{
  "name": "MobileAnimation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "react-native start",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "lint": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "test": "jest",
    "prepare": "husky install",
    "android": "ENVFILE=.env.loc react-native run-android",
    "android:dev": "ENVFILE=.env.dev react-native run-android",
    "android:iqa": "ENVFILE=.env.iqa react-native run-android",
    "android:qa": "ENVFILE=.env.qa react-native run-android",
    "android:preprod": "ENVFILE=.env.preprod react-native run-android",
    "android:prod": "ENVFILE=.env.prod react-native run-android",
    "android:build": "yarn android:clean && cd android && ENVFILE=.env.loc ./gradlew assembleRelease",
    "android:build:dev": "yarn android:clean && cd android && ENVFILE=.env.dev ./gradlew assembledevRelease",
    "android:build:iqa": "yarn android:clean && cd android && ENVFILE=.env.iqa ./gradlew assembleiqaRelease",
    "android:build:qa": "yarn android:clean && cd android && ENVFILE=.env.qa ./gradlew assembleqaRelease",
    "android:build:preprod": "yarn android:clean && cd android && ENVFILE=.env.preprod ./gradlew assemblepreprodRelease",
    "android:build:prod": "yarn android:clean && cd android && ENVFILE=.env.prod ./gradlew assembleprodRelease",
    "android:clean": "rm -rf ./android/app/build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "lucide-react-native": "^1.33.0",
    "react": "18.2.0",
    "react-native": "0.72.4",
    "react-native-svg": "^15.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/node": "^18.11.9",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "patch-package": "^8.0.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
