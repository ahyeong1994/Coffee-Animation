# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '13.0'
prepare_react_native_project!
$VCDisableFrameProcessors = true

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```
# Flipper bundled with React Native 0.72 is not compatible with the newer
# Clang toolchain in Xcode 26. It is only a development inspector and is not
# required by the app, so keep it disabled for reliable simulator/device builds.
flipper_config = FlipperConfiguration.disabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MobileAnimation' do
  config = use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is now enabled by default. Disable by setting this flag to false.
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'MobileAnimationTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    # React Native 0.72 emits unquoted Codegen environment exports. Those
    # scripts break when the project lives in a path containing spaces, such
    # as "/Volumes/External Hardisk/...". Patch every generated Codegen phase
    # after pod installation so future `pod install` runs remain safe.
    installer.pods_project.targets.each do |pod_target|
      pod_target.shell_script_build_phases.each do |phase|
        next unless phase.name == '[CP-User] Generate Specs'

        phase.shell_script = phase.shell_script.gsub(
          /^export (RCT_SCRIPT_(?:RN_DIR|APP_PATH|CONFIG_FILE_DIR|OUTPUT_DIR))=([^"\n]+)$/,
          'export \1="\2"'
        )
        phase.shell_script = phase.shell_script.gsub(
          '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
          '"$WITH_ENVIRONMENT" "$SCRIPT_PHASES_SCRIPT"'
        )
      end
    end
  end
end
